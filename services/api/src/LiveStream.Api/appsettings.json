{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "Postgres": ""
  },
  "Database": {
    "MigrateOnStartup": false
  },
  "Jwt": {
    "Issuer": "livestream-api",
    "Audience": "livestream-web",
    "AccessTokenLifetimeSeconds": 900,
    "SigningKey": ""
  },
  "InternalApi": {
    "SharedSecret": ""
  },
  "Media": {
    "MediaMtx": {
      "ControlApiUrl": "http://localhost:9997",
      "PublicWebRtcUrl": "http://localhost:8889",
      "PublicHlsUrl": "http://localhost:8888",
      "ControlApiTimeoutSeconds": 5
    },
    "Ice": {
      "Servers": [
        { "Urls": [ "stun:stun.l.google.com:19302" ] }
      ]
    }
  },
  "Recording": {
    "RootPath": "./recordings"
  },
  "LiveSessions": {
    "IngestCredentialLifetimeSeconds": 300,
    "RecoveryWindowSeconds": 120,
    "StartIngestTimeoutSeconds": 60,
    "HealthPollIntervalSeconds": 3,
    "HealthyBitrateKbps": 1200,
    "PoorBitrateKbps": 400,
    "MaxConcurrentSessionsPerWorkspace": 3
  },
  "Distribution": {
    "MaxDestinationsPerSession": 5,
    "MaxRetryAttempts": 5,
    "InitialRetryDelaySeconds": 5,
    "MaxRetryDelaySeconds": 120,
    "ConnectTimeoutSeconds": 45,
    "ReconcileIntervalSeconds": 5,
    "RelaySourceCredentialLifetimeSeconds": 21600,
    "TokenRefreshSkewSeconds": 300,
    "OAuthStateLifetimeSeconds": 600,
    "Relay": {
      "BaseUrl": "http://localhost:8090",
      "TimeoutSeconds": 10
    },
    "Providers": {
      "YouTube": { "ClientId": "", "ClientSecret": "" },
      "Facebook": { "ClientId": "", "ClientSecret": "" },
      "TikTok": { "ClientId": "", "ClientSecret": "" },
      "Twitch": { "ClientId": "", "ClientSecret": "" }
    }
  },
  "Sources": {
    "PairingCodeLifetimeSeconds": 600,
    "DeviceTokenLifetimeSeconds": 43200,
    "MaxSourcesPerSession": 8,
    "PreviewCredentialLifetimeSeconds": 300,
    "SourcePresenceGraceSeconds": 20
  },
  "JoinLink": {
    "BaseUrl": "http://localhost:3000"
  },
  "Secrets": {
    "PrimaryKeyId": "",
    "Keys": {}
  },
  "RateLimits": {
    "AuthenticationPerMinute": 10,
    "SessionCreationPerMinute": 20,
    "CredentialIssuancePerMinute": 60,
    "DestinationManagementPerMinute": 30,
    "DeviceManagementPerMinute": 30,
    "PairingAttemptsPerMinute": 10
  },
  "Cors": {
    "AllowedOrigins": [ "http://localhost:3000" ]
  },
  "OpenTelemetry": {
    "OtlpEndpoint": ""
  }
}
