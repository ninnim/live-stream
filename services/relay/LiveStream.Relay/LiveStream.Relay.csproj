<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>

  <ItemGroup>
    <!-- The encoder command line is the whole behaviour of this service, and building it wrong is
         invisible until a platform silently refuses a broadcast. It is tested directly rather than
         being made public for the sake of a test. -->
    <InternalsVisibleTo Include="LiveStream.Relay.Tests" />
  </ItemGroup>

</Project>
