{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",

  // Only what this file has to say. Every tuning value lives in RelayServiceOptions, with the
  // reasoning for the number beside it, and is overridden per deployment through the environment
  // (see infrastructure/docker/docker-compose.yml).
  //
  // Restating a default here is how they drift: this file used to carry VideoCodec "libx264",
  // 2500 kbps and 128 kbps audio, silently overriding three decisions taken in ADR 0017 for any
  // deployment that did not also set the environment variables.
  "Relay": {
    "SharedSecret": "",
    "SourceRtspBaseUrl": "rtsp://mediamtx:8554"
  }
}
