# Keep host build output out of the image.
#
# Without this, `COPY services/api/ ...` overwrites the restore output produced inside the container
# with the host's obj/project.assets.json, which references Windows NuGet paths that do not exist in
# the image — and `dotnet publish --no-restore` then fails to resolve packages.
**/bin/
**/obj/
**/node_modules/
**/.next/
**/TestResults/
**/coverage/

# Local runtime data and secrets — must never enter an image layer.
**/.env
**/.env.*
!**/.env.example
infrastructure/docker/data/
recordings/
**/*.log

# Version control and editor state.
.git/
.github/
.vs/
.vscode/
.idea/
**/*.user

# Playwright artefacts.
apps/web/test-results/
apps/web/playwright-report/
