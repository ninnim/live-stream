# Copy to `.env` next to docker-compose.yml and fill in real values.
# Never commit a filled-in copy: these are secrets.

# Generate with:  openssl rand -base64 48
JWT_SIGNING_KEY=

# Shared secret the media gateway presents on its callbacks into the API.
# Generate with:  openssl rand -hex 32
INTERNAL_API_SECRET=

# Shared secret the API presents to the egress relay. Deliberately separate from the media gateway
# secret: the two services have different blast radii, and one secret for both means a compromise
# of either grants the other.
# Generate with:  openssl rand -hex 32
RELAY_SECRET=

# Encrypts stream keys and OAuth tokens at rest. Must decode to exactly 32 bytes.
# Generate with:  openssl rand -base64 32
#
# Losing this makes every stored destination credential permanently unreadable. Back it up, and use
# a real secret store in production. To rotate: add Secrets__Keys__<new-id> to docker-compose.yml
# alongside the existing one, repoint Secrets__PrimaryKeyId, and keep the old key until every row
# has been re-saved.
SECRETS_KEY=

POSTGRES_PASSWORD=livestream

# Public URLs handed to the browser. Change these when running behind a domain or HTTPS proxy.
PUBLIC_API_URL=http://localhost:8080
PUBLIC_WEBRTC_URL=http://localhost:8889
PUBLIC_HLS_URL=http://localhost:8888
WEB_ORIGIN=http://localhost:3000

# ---------------------------------------------------------------------------------------------
# Multi-platform distribution (Phase 2)
# ---------------------------------------------------------------------------------------------

# Encoder settings for republishing to external platforms.
# libx264 always works. "copy" skips re-encoding entirely and is correct only when the browser
# negotiated H.264 — much cheaper, but it fails outright on a VP8 stream.
# RELAY_VIDEO_CODEC=libx264
# RELAY_VIDEO_PRESET=veryfast
# RELAY_VIDEO_BITRATE_KBPS=2500
# RELAY_MAX_CONCURRENT=50

# OAuth clients for linked accounts. Leave blank to use stream keys only, which works for every
# platform and needs no app registration or review.
#
# YouTube: Google Cloud project, YouTube Data API v3 enabled, OAuth client of type "Web
# application", with your callback URL as an authorized redirect URI.
# YOUTUBE_CLIENT_ID=
# YOUTUBE_CLIENT_SECRET=

# Facebook: Meta app with Facebook Login and the publish_video permission. Live publishing through
# the API requires Meta app review; stream-key destinations do not.
# FACEBOOK_CLIENT_ID=
# FACEBOOK_CLIENT_SECRET=

# ---------------------------------------------------------------------------------------------
# Multi-device contribution (Phase 4)
# ---------------------------------------------------------------------------------------------

# Where a pairing QR code points. This must be an address the phone scanning it can reach — a link
# to localhost resolves to the phone itself, which is the commonest reason pairing "does nothing".
# Defaults to WEB_ORIGIN.
# JOIN_LINK_BASE_URL=http://192.168.1.20:3000

# MAX_SOURCES_PER_SESSION=8

# Abuse-control limits. The defaults are production-sane. An end-to-end run drives every request
# from one address, so it needs headroom — the CI e2e job raises these.
# RATE_LIMIT_AUTH_PER_MINUTE=1000
# RATE_LIMIT_SESSION_PER_MINUTE=1000
# RATE_LIMIT_CREDENTIAL_PER_MINUTE=1000
# RATE_LIMIT_DESTINATION_PER_MINUTE=1000
# RATE_LIMIT_DEVICE_PER_MINUTE=1000
# Raising this one weakens a real control: a pairing code is only eight characters, and the limit
# is part of what makes guessing it impractical. The e2e job raises it because it drives every
# request from a single address.
# RATE_LIMIT_PAIRING_PER_MINUTE=1000

# ---------------------------------------------------------------------------------------------
# AI operations (Phase 6)
# ---------------------------------------------------------------------------------------------

# Off by default. A deployment should have to choose to send its session data to a model, rather
# than discover that it already had. With this false, the AI panel does not appear at all.
# AI_ENABLED=true

# Anthropic API key. Server-side only — it is never sent to the browser, and the studio reaches the
# model only by asking this API to queue a job.
#
# Every job costs money. The platform deduplicates per session and feature, caps attempts at three,
# and reports the estimated cost of each job, but the bill is still real.
# ANTHROPIC_API_KEY=

# AI_MODEL=claude-opus-5

# Individual features can be switched off without turning AI off entirely, which is what the phase
# requires. Keys are the job kinds: SessionRecap, StreamQualityReview, Chapters.
# Ai__Features__Chapters=false

# ---------------------------------------------------------------------------------------------
# Scale, security and globalization (Phase 7)
# ---------------------------------------------------------------------------------------------

# One binary, composed into a tier. `All` runs HTTP and the background loops and is right for a
# single container. Split it to scale the two independently:
#   RUNTIME_ROLE=Api      — serves requests only; add replicas for request volume
#   RUNTIME_ROLE=Worker   — runs the background loops only; scales with sessions in flight
# RUNTIME_ROLE=All

# Whether a background loop must hold a database lease before doing work. Leave it on for anything
# with more than one instance: two unleased replicas reconcile the same session and pay for the
# same AI job twice. Turning it off saves one small write per loop per tick.
# RUNTIME_LEADER_ELECTION=true

# The region this deployment serves, e.g. eu-central. A workspace that pins its data residency to
# another region is refused here rather than served quietly — see docs/decisions/0015.
# DEPLOYMENT_REGION=

# Plan every new workspace starts on. Pro matches the limits this platform has enforced since
# Phase 1, so turning plans on changes nothing until an operator moves someone. A deployment with
# billing sets this to Free.
# DEFAULT_PLAN=Pro

# Whether expired recordings are actually deleted. Off keeps reporting the expiry date and deletes
# nothing, which is the honest setting while validating a policy.
# RETENTION_ENABLED=true

# Optional CDN or edge origin in front of HLS playback, e.g. https://cdn.example.com. Only HLS
# moves behind it: WHEP is a negotiated peer connection to the gateway, and a cache in front of it
# would break playback rather than speed it up.
# PUBLIC_HLS_CDN_URL=

# Unit rates for the cost report. Leave a rate unset and the platform reports that line as unknown
# rather than as zero — a cost shown as free is one nobody budgets for. AI spend is not here: it is
# priced from the tokens each job actually used.
# COST_CURRENCY=USD
# COST_STREAMING_PER_HOUR=0.35
# COST_EGRESS_PER_GB=0.08
# COST_STORAGE_PER_GB_MONTH=0.02
# COST_RELAY_PER_HOUR=0.12

# Single sign-on needs no deployment-wide configuration: each workspace supplies its own issuer,
# client id and client secret, and the redirect URI is derived from WEB_ORIGIN. A claimed email
# domain stays inert until an operator verifies it:
#
#   curl -X PUT http://localhost:8080/api/v1/operations/sso-domains/example.com \
#        -H "X-Internal-Auth: $INTERNAL_API_SECRET" \
#        -H 'Content-Type: application/json' -d '{"verified":true}'
